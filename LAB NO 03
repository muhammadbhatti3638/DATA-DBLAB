        "import csv\n",
        "import io\n",
        "import re\n",
        "\n",
        "file_path = 'students_marks.csv'\n",
        "students_data = []\n",
        "\n",
        "with open(file_path, mode='r', encoding='utf-8') as f:\n",
        "    lines = []\n",
        "    for line in f:\n",
        "        line_str = line.strip().strip('\"')\n",
        "        if '\\x0c' in line_str or not line_str:\n",
        "            continue\n",
        "        # Convert consecutive spaces (2 or more) into a standard comma delimiter\n",
        "        cleaned_line = re.sub(r'\\s{2,}', ',', line_str)\n",
        "        lines.append(cleaned_line)\n",
        "\n",
        "csv_buffer = io.StringIO('\\n'.join(lines))\n",
        "reader = csv.DictReader(csv_buffer)\n",
        "\n",
        "for row in reader:\n",
        "    # Skip corrupted/unaligned shorter trailing rows\n",
        "    if not row.get('RollNo') or not row.get('Name') or ',' in str(row.get('RollNo')):\n",
        "        continue\n",
        "\n",
        "    marks = []\n",
        "    # Convert any numeric subject columns to float/int\n",
        "    for key in list(row.keys()):\n",
        "        if key not in ['RollNo', 'Name', 'Section'] and key is not None and row[key] is not None:\n",
        "            try:\n",
        "                val = float(row[key])\n",
        "                row[key] = int(val) if val.is_integer() else val\n",
        "                marks.append(val)\n",
        "            except ValueError:\n",
        "                pass\n",
        "\n",
        "    if marks:\n",
        "        row['Average'] = round(sum(marks) / len(marks), 2)\n",
        "    else:\n",
        "        row['Average'] = 0.0\n",
        "    students_data.append(row)\n",
        "\n",
        "# Display the loaded records\n",
        "for s in students_data[:5]:\n",
        "    print(s)"
