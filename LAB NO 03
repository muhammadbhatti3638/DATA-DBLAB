        "import csv, json\n",
        "from sqlalchemy import create_engine, text\n",
        "\n",
        "# 1. Marks (CSV): compute the Average\n",
        "with open(\"students_marks.csv\") as f:\n",
        "    students = list(csv.DictReader(f))\n",
        "\n",
        "subjects = [\"Math\", \"Stats\", \"Python\", \"Databases\", \"English\"]\n",
        "for s in students:\n",
        "    for sub in subjects:\n",
        "        s[sub] = int(s[sub])\n",
        "    s[\"Average\"] = round(sum(s[sub] for sub in subjects) / len(subjects), 2)\n",
        "\n",
        "# 2. City and Hostel (JSON, handles the wrapped file)\n",
        "with open(\"students_info.json\") as f:\n",
        "    data = json.load(f)\n",
        "if isinstance(data, dict):\n",
        "    info = json.loads(data[\"pages\"][0][\"children\"][0][\"text\"].replace(\"\\n\", \"\"))\n",
        "else:\n",
        "    info = data\n",
        "details = {s[\"RollNo\"]: s for s in info}\n",
        "\n",
        "# 3. Fee status (database): Use 'university.db (2).db' which contains the correct 'fees' table\n",
        "uni = create_engine(\"sqlite:///university.db (2).db\")\n",
        "with uni.connect() as conn:\n",
        "    fees = conn.execute(text(\"SELECT RollNo, DueDate, PaidOn FROM fees\")).fetchall()\n",
        "\n",
        "fee_status = {}\n",
        "for roll, due, paid in fees:\n",
        "    if paid is None:\n",
        "        fee_status[roll] = \"Unpaid\"\n",
        "    elif paid > due:\n",
        "        fee_status[roll] = \"Late\"\n",
        "    else:\n",
        "        fee_status[roll] = \"On time\"\n",
        "\n",
        "# 4. Join the three sources with RollNo\n",
        "packet = []\n",
        "for s in students:\n",
        "    roll = s[\"RollNo\"]\n",
        "    packet.append({\n",
        "        \"RollNo\": roll,\n",
        "        \"Name\": s[\"Name\"],\n",
        "        \"Section\": s[\"Section\"],\n",
        "        \"City\": details[roll][\"Contact\"][\"City\"],\n",
        "        \"Hostel\": details[roll][\"Hostel\"],\n",
        "        \"Average\": s[\"Average\"],\n",
        "        \"FeeStatus\": fee_status[roll],\n",
        "    })\n",
        "\n",
        "with open(\"students_full.json\", \"w\") as f:\n",
        "    json.dump(packet, f, indent=2)\n",
        "\n",
        "print(len(packet), \"students saved\")\n",
        "print(packet[0])"
