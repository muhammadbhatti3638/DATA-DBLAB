        "import json\n",
        "import re\n",
        "\n",
        "# Load the JSON file\n",
        "with open(\"students_info.json\") as f:\n",
        "    info = json.load(f)\n",
        "\n",
        "# The JSON file is structured as a layout dictionary with pages, rather than a direct list.\n",
        "# We recursively traverse the layout to find text records that store the contact details.\n",
        "city_count = {}\n",
        "\n",
        "def extract_cities_from_layout(item):\n",
        "    if isinstance(item, dict):\n",
        "        if 'text' in item and isinstance(item['text'], str):\n",
        "            # Look for contact pattern blocks and extract the City name\n",
        "            city_matches = re.findall(r'\"[Cc]ity\"\\s*:\\s*\"([^\"]+)\"|City\\s*:\\s*([^\\n,\\r]+)', item['text'])\n",
        "            for match in city_matches:\n",
        "                city_name = match[0] or match[1]\n",
        "                if city_name:\n",
        "                    cleaned_city = city_name.strip().strip('\"').strip().title()\n",
        "                    city_count[cleaned_city] = city_count.get(cleaned_city, 0) + 1\n",
        "        for value in item.values():\n",
        "            extract_cities_from_layout(value)\n",
        "    elif isinstance(item, list):\n",
        "        for element in item:\n",
        "            extract_cities_from_layout(element)\n",
        "\n",
        "extract_cities_from_layout(info)\n",
        "print(city_count)"
      ],
